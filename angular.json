{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ng-platform-noop": {
      "projectType": "library",
      "root": "projects/ng-platform-noop",
      "sourceRoot": "projects/ng-platform-noop/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-platform-noop/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-platform-noop/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ng-platform-noop/tsconfig.spec.json"
          }
        }
      }
    },
    "sample-noop-app": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/sample-noop-app",
      "sourceRoot": "projects/sample-noop-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "projects/sample-noop-app/tsconfig.app.json",
            "index": "projects/sample-noop-app/src/main.ts"
          },
          "configurations": {
            "production": {
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
