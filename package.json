{
  "name": "ng-opentui",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "bun x ng",
    "build": "bun run build:lib && npm run build:app",
    "build:lib": "bun x ng build ng-platform-opentui",
    "build:app": "bun x ngc -p ./projects/sample-opentui-app/tsconfig.ngc.json",
    "prestart": "bun run build",
    "start": "bun ./dist/sample-opentui-app-ngc/main.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.1.4",
    "@angular/compiler": "^21.1.4",
    "@angular/core": "^21.1.4",
    "@angular/forms": "^21.1.4",
    "@angular/platform-browser": "^21.1.4",
    "@angular/router": "^21.1.4",
    "@opentui/core": "^0.1.79",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.4",
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.4",
    "@angular/platform-server": "^21.1.4",
    "@types/node": "^25.2.3",
    "jsdom": "^27.4.0",
    "ng-packagr": "^21.1.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
